@using RecipeCost.Shared
@using RecipeCostUI.Models

<div class="card mb-4">
    <div class="card-body">
        <h5>@(IsEditing ? $"Editing {Model.Name}" : "Create New Recipe")</h5>
        <EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Recipe Name</label>
                    <InputText @bind-Value="Model.Name" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label>Servings</label>
                    <InputNumber @bind-Value="Model.Servings" class="form-control" />
                </div>
            </div>

            <h6>Ingredients</h6>
            <IngredientSelector Ingredients="AvailableIngredients" IngredientAdded="AddIngredient" />

            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Ingredient</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Ingredients)
                    {
                        <tr>
                            <td>@item.IngredientName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Unit</td>
                            <td>
                                <button type="button" class="btn btn-link text-danger" @onclick="() => RemoveIngredient(item)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save Recipe</button>
                @if (IsEditing)
                {
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public RecipeFormModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<IngredientDto> AvailableIngredients { get; set; } = Array.Empty<IngredientDto>();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmit() => OnSave.InvokeAsync();

    private void AddIngredient(RecipeIngredientFormModel ingredient)
    {
        Model.Ingredients.Add(ingredient);
    }

    private void RemoveIngredient(RecipeIngredientFormModel ingredient)
    {
        Model.Ingredients.Remove(ingredient);
    }

    private Task Cancel() => OnCancel.InvokeAsync();
}
