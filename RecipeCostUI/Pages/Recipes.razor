@page "/recipes"
@using RecipeCost.Shared
@using RecipeCostUI.Models
@implements IDisposable
@inject AppState AppState
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject ISnackbar Snackbar

<h3>Recipe Manager</h3>

<RecipeForm Model="formModel"
            AvailableIngredients="availableIngredients"
            IsEditing="isEditing"
            OnSave="HandleSave"
            OnCancel="CancelEdit" />

<RecipeList Recipes="recipeList" EditRequested="StartEdit" />

@code {
    private List<RecipeDto> recipeList = new();
    private List<IngredientDto> availableIngredients = new();
    private RecipeFormModel formModel = new();
    private bool isEditing;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleAppStateChanged;
        await LoadDataFromStateOrApi();
    }

    private async Task LoadDataFromStateOrApi()
    {
        if (AppState.HasRecipes && AppState.HasIngredients)
        {
            UseAppState();
            return;
        }

        await HydrateData();
    }

    private async Task HydrateData()
    {
        try
        {
            var recipes = AppState.HasRecipes
                ? AppState.Recipes
                : await RecipeService.GetRecipesAsync();

            var ingredients = AppState.HasIngredients
                ? AppState.Ingredients
                : await IngredientService.GetIngredientsAsync();

            AppState.SetData(ingredients, recipes);
            UseAppState();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load recipe data: {ex.Message}", Severity.Error);
        }
    }

    private async Task HydrateRecipes()
    {
        try
        {
            var recipes = await RecipeService.GetRecipesAsync();
            AppState.SetRecipes(recipes);
            UseAppState();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load recipes: {ex.Message}", Severity.Error);
        }
    }

    private void UseAppState()
    {
        recipeList = AppState.Recipes;
        availableIngredients = AppState.Ingredients;
    }

    private void HandleAppStateChanged()
    {
        UseAppState();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleSave()
    {
        try
        {
            if (isEditing)
            {
                await RecipeService.UpdateRecipeAsync(formModel.ToDto());
            }
            else
            {
                await RecipeService.CreateRecipeAsync(formModel.ToDto());
            }

            Snackbar.Add(isEditing ? "Recipe updated successfully." : "Recipe saved successfully.", Severity.Success);
            formModel = new();
            isEditing = false;
            await HydrateRecipes();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save recipe: {ex.Message}", Severity.Error);
        }
    }

    private void StartEdit(RecipeDto dto)
    {
        isEditing = true;
        formModel = new RecipeFormModel
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            Servings = dto.Servings,
            Ingredients = dto.Ingredients.Select(i => new RecipeIngredientFormModel
            {
                IngredientId = i.IngredientId,
                IngredientName = i.IngredientName,
                Quantity = i.Quantity,
                Unit = i.BaseUnit
            }).ToList()
        };
    }

    private void CancelEdit()
    {
        formModel = new();
        isEditing = false;
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleAppStateChanged;
    }
}
