@page "/ingredients"
@using RecipeCost.Shared
@implements IDisposable
@inject AppState AppState
@inject IngredientService IngredientService
@inject ISnackbar Snackbar

<h3>Ingredient Manager</h3>

<div class="card mb-4">
    <div class="card-body">
        <h5>@(isEditing ? $"Editing {formModel.Name}" : "Add New Ingredient")</h5>
        <EditForm Model="formModel" OnValidSubmit="HandleSave">
            <div class="row">
                <div class="col"> 
                    <input @bind="formModel.Name" class="form-control" placeholder="Name" />
                </div> 
                <div class="col">
                    <input @bind="formModel.CostPerUserUnit" type="number" step="0.0001" class="form-control" placeholder="Cost ($)" />
                </div> 
                <div class="col"> 
                    <InputSelect @bind-Value="formModel.UserUnit" class="form-control">
                        @foreach (var unit in Enum.GetValues<UnitType>())
                        {
                            <option value="@unit">@unit</option>
                        } 
                    </InputSelect>
                </div> 
                <div class="col">
                    <button type="submit" class="btn btn-primary">@(isEditing ? "Update" : "Save")</button>
                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

<MudDataGrid T="IngredientDto"
             Items="@ingredientList"
             Dense="true"
             Hover="true"
             Striped="true"
             Bordered="true"
             Filterable="true"
             SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="ingredient => ingredient.Name" Title="Name" />
        <TemplateColumn Title="Cost/Unit">
            <CellTemplate>
                @FormatCurrency(context.Item.CostPerUserUnit)
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="ingredient => ingredient.UserUnit" Title="User Unit" />
        <TemplateColumn Title="Cost/Base Unit">
            <CellTemplate>
                @FormatCurrency(context.Item.CostPerBaseUnit)
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="ingredient => ingredient.BaseUnit" Title="Base Unit" />
        <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => StartEdit(context.Item))" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => HandleDelete(context.Item.Id))" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="IngredientDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private List<IngredientDto> ingredientList = new();
    
    // The form now binds to this mutable object
    private IngredientFormModel formModel = new(); 
    private bool isEditing = false;

    private static string FormatCurrency(decimal value) => $"${value:0.00##}";

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleAppStateChanged;
        await LoadIngredientsFromStateOrApi();
    }

    private async Task LoadIngredientsFromStateOrApi()
    {
        if (AppState.HasIngredients)
        {
            UseAppState();
            return;
        }

        await HydrateIngredients();
    }

    private async Task HydrateIngredients()
    {
        try
        {
            var ingredients = await IngredientService.GetIngredientsAsync();
            AppState.SetIngredients(ingredients);
            UseAppState();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load ingredients: {ex.Message}", Severity.Error);
        }
    }

    private void UseAppState()
    {
        ingredientList = AppState.Ingredients;
    }

    private void HandleAppStateChanged()
    {
        UseAppState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void StartEdit(IngredientDto item)
    {
        // Load the form from the DTO
        formModel = IngredientFormModel.FromDto(item);
        isEditing = true;
    }

    private async Task HandleSave()
    {
        try
        {
            // Convert the mutable form back into an immutable DTO for the API
            var dtoToSave = formModel.ToDto();

            if (isEditing)
            {
                await IngredientService.UpdateIngredientAsync(dtoToSave);
                Snackbar.Add("Ingredient updated successfully.", Severity.Success);
            }
            else
            {
                await IngredientService.CreateIngredientAsync(dtoToSave);
                Snackbar.Add("Ingredient saved successfully.", Severity.Success);
            }

            await HydrateIngredients();
            CancelEdit(); // Ensure we exit edit mode
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save ingredient: {ex.Message}", Severity.Error);
        }
    }

    private void CancelEdit()
    {
        formModel = new(); // Clears the input fields
        isEditing = false; // Reverts UI from "Update" to "Save" mode
    }

    private async Task HandleDelete(int id)
    {
        // If the user is currently editing the item they are about to delete,
        // we should cancel the edit to prevent them from trying to 'Update' a ghost.
        if (isEditing && formModel.Id == id)
        {
            CancelEdit();
        }

        try
        {
            await IngredientService.DeleteIngredientAsync(id);
            Snackbar.Add("Ingredient deleted successfully.", Severity.Success);
            await HydrateIngredients();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete ingredient: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleAppStateChanged;
    }

    // This is our mutable "Work Area" for the form
    public class IngredientFormModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty; 
        public decimal CostPerUserUnit { get; set; }  
        public UnitType UserUnit { get; set; }  
        // Helper to turn the form data back into an Immutable DTO
        public IngredientDto ToDto() => new IngredientDto
        {
            Id = this.Id,
            Name = this.Name, 
            UserUnit = this.UserUnit,
            CostPerUserUnit = this.CostPerUserUnit
        };

        // Helper to fill the form from an existing DTO
        public static IngredientFormModel FromDto(IngredientDto dto) => new()
        {
            Id = dto.Id,
            Name = dto.Name, 
            CostPerUserUnit = dto.CostPerUserUnit,
            UserUnit = dto.UserUnit
        };
    }
}
